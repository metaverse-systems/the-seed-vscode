{
  "name": "the-seed-vscode",
  "displayName": "The Seed",
  "publisher": "metaverse-systems",
  "description": "Create, build, sign and package the-seed projects from the editor.",
  "version": "1.0.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaverse-systems/the-seed-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/metaverse-systems/the-seed-vscode/issues"
  },
  "homepage": "https://github.com/metaverse-systems/the-seed-vscode#readme",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "the-seed",
    "ecs",
    "game engine",
    "c++",
    "autotools",
    "mingw",
    "resource pak"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "the-seed-sidebar",
          "title": "The Seed",
          "icon": "media/the-seed-icon.svg"
        }
      ]
    },
    "views": {
      "the-seed-sidebar": [
        {
          "type": "webview",
          "id": "the-seed.mainView",
          "name": "The Seed"
        }
      ]
    },
    "configuration": {
      "title": "The Seed",
      "properties": {
        "the-seed.toolPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Where the the-seed tool is installed, when it is not in the global npm installation: its package directory (for example `/opt/node/lib/node_modules/@metaverse-systems/the-seed`), its `the-seed` command, or a path inside it. Leave empty to use the global installation, then the `the-seed` command on the path. Needs the-seed 2.1.0 or a later 2.x."
        }
      }
    },
    "commands": [
      {
        "command": "the-seed.checkTool",
        "title": "The Seed: Check Tool"
      },
      {
        "command": "the-seed.createResourcePak",
        "title": "The Seed: Create ResourcePak"
      },
      {
        "command": "the-seed.configureProject",
        "title": "The Seed: Configure Project"
      },
      {
        "command": "the-seed.showConfig",
        "title": "The Seed: Show Config"
      },
      {
        "command": "the-seed.listScopes",
        "title": "The Seed: List Scopes"
      },
      {
        "command": "the-seed.addScope",
        "title": "The Seed: Add Scope"
      },
      {
        "command": "the-seed.editScope",
        "title": "The Seed: Edit Scope"
      },
      {
        "command": "the-seed.deleteScope",
        "title": "The Seed: Delete Scope"
      },
      {
        "command": "the-seed.createComponentTemplate",
        "title": "The Seed: Create Component Template"
      },
      {
        "command": "the-seed.createSystemTemplate",
        "title": "The Seed: Create System Template"
      },
      {
        "command": "the-seed.createProgramTemplate",
        "title": "The Seed: Create Program Template"
      },
      {
        "command": "the-seed.buildNative",
        "title": "The Seed: Build Native"
      },
      {
        "command": "the-seed.buildWindows",
        "title": "The Seed: Build Windows"
      },
      {
        "command": "the-seed.buildIncremental",
        "title": "The Seed: Build (Incremental)"
      },
      {
        "command": "the-seed.buildNativeRecursive",
        "title": "The Seed: Build Native (Recursive)"
      },
      {
        "command": "the-seed.buildWindowsRecursive",
        "title": "The Seed: Build Windows (Recursive)"
      },
      {
        "command": "the-seed.addResource",
        "title": "The Seed: ResourcePak Add Resource"
      },
      {
        "command": "the-seed.buildResourcePak",
        "title": "The Seed: ResourcePak Build"
      },
      {
        "command": "the-seed.checkDependencies",
        "title": "The Seed: Check Dependencies"
      },
      {
        "command": "the-seed.installDependencies",
        "title": "The Seed: Install Dependencies"
      },
      {
        "command": "the-seed.packageProject",
        "title": "The Seed: Package Projects"
      },
      {
        "command": "the-seed.createSigningCert",
        "title": "The Seed: Create Signing Certificate"
      },
      {
        "command": "the-seed.importSigningCert",
        "title": "The Seed: Import Signing Certificate"
      },
      {
        "command": "the-seed.signFile",
        "title": "The Seed: Sign File"
      },
      {
        "command": "the-seed.verifySignature",
        "title": "The Seed: Verify Signature"
      },
      {
        "command": "the-seed.signingCertInfo",
        "title": "The Seed: Signing Certificate Info"
      },
      {
        "command": "the-seed.exportSigningCert",
        "title": "The Seed: Export Signing Certificate"
      },
      {
        "command": "the-seed.generateWindowsInstaller",
        "title": "The Seed: Generate Windows Installer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "the-seed.signFile",
          "group": "the-seed@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "the-seed.verifySignature",
          "group": "the-seed@2",
          "when": "!explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node scripts/run-checks.js clean compile",
    "typecheck": "node scripts/run-checks.js typecheck",
    "build:webview": "vite build --config vite.config.webview.mts",
    "build": "node scripts/run-checks.js clean compile typecheck bundle",
    "bundle": "node scripts/run-checks.js bundle",
    "package": "node scripts/run-checks.js package",
    "watch": "node scripts/run-checks.js watch",
    "lint": "node scripts/run-checks.js lint",
    "lint-fix": "node ./node_modules/eslint/bin/eslint.js src --fix",
    "test": "node scripts/run-checks.js"
  },
  "devDependencies": {
    "@metaverse-systems/the-seed": "2.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "1.140.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vscode-elements/elements": "^2.5.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sinon": "^21.0.1",
    "typescript": "^5.7.3",
    "vite": "^7.3.1"
  }
}
